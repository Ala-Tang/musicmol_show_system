# MusicMol unified deployment defaults.
# Copy to a shell export file or source selectively; run_unified.sh already uses these defaults.

MUSICMOL_UNIFIED=1
MUSICMOL_LISTEN_HOST=0.0.0.0
MUSICMOL_LISTEN_PORT=9080
MUSICMOL_INFERENCE_DEVICE=auto

# Online inference tuning.
MUSICMOL_BEAM_SIZE=8
MUSICMOL_NUM_RETURN=8
MUSICMOL_MAX_DECODE_LEN=256

# Set to 1 for lightweight smoke checks only. Production should leave warmup enabled.
MUSICMOL_WARMUP_DISABLE=0

# Optional split-mode service ports.
PAINOJS_STATIC_PORT=8766
RDKIT_EMBED_PORT=8767
MUSICMOL_UI_POLL_PORT=8082
